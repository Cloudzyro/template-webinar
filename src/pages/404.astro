---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found" description="This page doesn't exist.">
  <section class="wrap nf">
    <p class="mono">404</p>
    <h1>Nothing is on air at this address</h1>
    <p>The link may be old or mistyped. The webinar page is one click away.</p>
    <a class="btn btn-primary" href="/">Go to the webinar</a>
  </section>
</Base>

<style>
  .nf {
    display: grid;
    gap: 1rem;
    justify-items: start;
    min-height: 60vh;
    align-content: center;
    max-width: 40rem;
  }
  h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    letter-spacing: -0.02em;
  }
  .nf > p:not(.mono) {
    color: var(--text-2);
  }
</style>
